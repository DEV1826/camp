  camp       Camp        @relation(fields: [campId], references: [id], onDelete: Cascade)
  classe     Classe?     @relation(fields: [classeId], references: [id], onDelete: SetNull)
  enseignant Enseignant? @relation(fields: [enseignantId], references: [id], onDelete: SetNull)

  @@index([campId])
  @@map("activites_ecole")
}

