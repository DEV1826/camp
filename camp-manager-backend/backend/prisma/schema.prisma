// ============================================================
//  Camp Manager — Schéma Prisma
//  Stack : PostgreSQL + Prisma ORM
//  Généré pour le projet de gestion de camp d'adolescents
// ============================================================

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local, "rhel-openssl-3.0.x" pour les fonctions
  // serverless Vercel (runtime Amazon Linux/Node 18+)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  ANIMATEUR
  PARENT
}

enum StatutCamp {
  BROUILLON
  OUVERT
  COMPLET
  EN_COURS
  TERMINE
  ANNULE
}

enum StatutInscription {
  EN_ATTENTE
  CONFIRME
  ANNULE
  LISTE_ATTENTE
}

enum StatutPaiement {
  EN_ATTENTE
  PARTIEL
  PAYE
  REMBOURSE
  ANNULE
}

enum MethodePaiement {
  ESPECES
  VIREMENT
  MOBILE_MONEY
  CARTE_BANCAIRE
  CHEQUE
}

enum StatutAnimateur {
  ACTIF
  INACTIF
  SUSPENDU
}

enum TypeDocument {
  AUTORISATION_PARENTALE
  FICHE_SANTE
  PHOTO_IDENTITE
  CERTIFICAT_MEDICAL
  AUTRE
}

enum StatutDocument {
  EN_ATTENTE
  VALIDE
  REJETE
}

enum TypeNotification {
  PAIEMENT_RELANCE
  DOCUMENT_MANQUANT
  ACTIVITE_RAPPEL
  INSCRIPTION_CONFIRMEE
  MESSAGE_RECU
  ANNONCE_GENERALE
}

enum RelationParent {
  PERE
  MERE
  TUTEUR
  AUTRE
}

enum TypeEspace {
  CAMP
  ECOLE
}

enum CouleurEval {
  VERT
  JAUNE
  ORANGE
  ROUGE
}

enum TypeProgramme {
  MENSUEL
  HEBDOMADAIRE
  MATIN
  RYTHME_DE_VIE
}

enum TypePresence {
  ANIMATEUR
  ENFANT
}

// ─────────────────────────────────────────
//  USER — Comptes d'accès
// ─────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  nom              String
  prenom           String
  email            String    @unique
  motDePasseHash   String    @map("mot_de_passe_hash")
  role             Role      @default(PARENT)
  avatarUrl        String?   @map("avatar_url")
  actif            Boolean   @default(true)
  campId           String?   @map("camp_id")
  permissions      String[]  @default([])
  dernierLogin     DateTime? @map("dernier_login")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  camp             Camp?          @relation(fields: [campId], references: [id], onDelete: SetNull)
  messagesEnvoyes  Message[]      @relation("expediteur")
  notifications    Notification[]

  @@index([campId])
  @@map("users")
}

// ─────────────────────────────────────────
//  CAMP — Session de camp
// ─────────────────────────────────────────

model Camp {
  id           String     @id @default(uuid())
  nom          String
  description  String?
  lieu         String
  adresse      String?
  dateDebut    DateTime   @map("date_debut")
  dateFin      DateTime   @map("date_fin")
  capaciteMax  Int        @map("capacite_max")
  prixBase     Decimal    @default(0) @map("prix_base") @db.Decimal(10, 2)
  type         TypeEspace @default(CAMP)
  statut       StatutCamp @default(BROUILLON)
  imageUrl     String?    @map("image_url")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  participants    Participant[]
  animateurs      Animateur[]
  groupes         Groupe[]
  activites       Activite[]
  messages        Message[]
  notifications   Notification[]
  statsSnapshots  StatistiqueSnap[]
  depenses        Depense[]
  fichePresences  FichePresence[]
  visiteurs       Visiteur[]
  dons            Don[]
  paroisses       CampParoisse[]
  enseignements   Enseignement[]
  causeries       CauserieGroupe[]
  users           User[]
  champsEleve     String[]   @default(["sexe", "dateNaissance", "lieuNaissance", "parent", "telephoneParent", "classe", "groupes", "notes"]) @map("champs_eleve")
  eleves          Eleve[]
  classes         Classe[]
  groupesEcole    GroupeEcole[]
  competences     Competence[]
  programmes      ProgrammeEcole[]
  enseignants     Enseignant[]
  activitesEcole  ActiviteEcole[]
  depensesEcole   DepenseEcole[]
  messagesEcole   MessageEcole[]
  sortiesEleves   SortieEleve[]
  visiteursEcole  VisiteurEcole[]
  donsEcole       DonEcole[]
  rapportsJour    RapportJour[]
  lecons          LeconEcole[]
  causeriesEcole  CauserieEcole[]

  @@map("camps")
}

// ─────────────────────────────────────────
//  CAMP PAROISSE — Paroisses d'un camp
// ─────────────────────────────────────────

model CampParoisse {
  id              String   @id @default(uuid())
  campId          String   @map("camp_id")
  nom             String
  responsable     String?
  telephone       String?
  prixParticipant Decimal? @map("prix_participant") @db.Decimal(10, 2)

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("camp_paroisses")
}

// ─────────────────────────────────────────
//  PARTICIPANT — Adolescent inscrit
// ─────────────────────────────────────────

model Participant {
  id                String            @id @default(uuid())
  campId            String            @map("camp_id")
  nom               String
  prenom            String
  dateNaissance     DateTime          @map("date_naissance")
  lieuNaissance     String?           @map("lieu_naissance")
  genre             String?
  nationalite       String?
  niveauScolaire    String?           @map("niveau_scolaire")
  participationsAnterieures Int?      @default(0) @map("participations_anterieures")
  contactAdolescent String?           @map("contact_adolescent")
  paroisse          String?
  responsableParoisse  String?        @map("responsable_paroisse")
  responsableTelephone String?        @map("responsable_telephone")
  groupeSanguin     String?           @map("groupe_sanguin")
  infosMedicales    String?           @map("infos_medicales")
  allergies         String?
  medicaments       String?
  nomUrgence        String            @map("nom_urgence")
  telephoneUrgence  String            @map("telephone_urgence")
  statutInscription StatutInscription @default(EN_ATTENTE) @map("statut_inscription")
  dispense          Boolean           @default(false)
  numeroChambre     String?           @map("numero_chambre")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  camp        Camp                 @relation(fields: [campId], references: [id], onDelete: Cascade)
  parents     Parent[]
  paiements   Paiement[]
  documents   Document[]
  groupes     ParticipantGroupe[]
  articlesSac ArticleSac[]

  @@map("participants")
}

// ─────────────────────────────────────────
//  PARENT — Contact parental
// ─────────────────────────────────────────

model Parent {
  id            String         @id @default(uuid())
  participantId String         @map("participant_id")
  nom           String
  prenom        String
  email         String
  telephone     String
  telephone2    String?
  relation      RelationParent @default(PERE)
  principal     Boolean        @default(false)
  createdAt     DateTime       @default(now()) @map("created_at")

  // Relations
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@map("parents")
}

// ─────────────────────────────────────────
//  ANIMATEUR — Membre du personnel
// ─────────────────────────────────────────

model Animateur {
  id          String          @id @default(uuid())
  nom         String
  prenom      String
  campId      String          @map("camp_id")
  specialite  String?
  telephone   String?
  missions    String?
  statut      StatutAnimateur @default(ACTIF)
  dateArrivee DateTime?       @map("date_arrivee")
  dateDepart  DateTime?       @map("date_depart")
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  camp        Camp       @relation(fields: [campId], references: [id], onDelete: Cascade)
  activites   Activite[]
  groupes     Groupe[]

  @@map("animateurs")
}

// ─────────────────────────────────────────
//  GROUPE — Sous-groupe dans un camp
// ─────────────────────────────────────────

model Groupe {
  id          String   @id @default(uuid())
  campId      String   @map("camp_id")
  nom         String
  couleur     String   @default("#6366f1")
  categorie   String?
  animateurId String?  @map("animateur_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  camp         Camp                @relation(fields: [campId], references: [id], onDelete: Cascade)
  animateur    Animateur?          @relation(fields: [animateurId], references: [id])
  participants ParticipantGroupe[]
  activites    ActiviteGroupe[]
  causeries    CauserieGroupe[]

  @@map("groupes")
}

// ─────────────────────────────────────────
//  PARTICIPANT_GROUPE — Jonction many-to-many
// ─────────────────────────────────────────

model ParticipantGroupe {
  participantId String   @map("participant_id")
  groupeId      String   @map("groupe_id")
  assigneAt     DateTime @default(now()) @map("assigne_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  groupe      Groupe      @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@id([participantId, groupeId])
  @@map("participant_groupes")
}

// ─────────────────────────────────────────
//  ACTIVITE — Planning des activités
// ─────────────────────────────────────────

model Activite {
  id             String   @id @default(uuid())
  campId         String   @map("camp_id")
  animateurId    String?  @map("animateur_id")
  titre          String
  description    String?
  lieu           String?
  dateHeureDebut DateTime @map("date_heure_debut")
  dateHeureFin   DateTime @map("date_heure_fin")
  capaciteMax    Int?     @map("capacite_max")
  couleur        String   @default("#0ea5e9")
  materiel       String?
  statut         String   @default("PLANIFIE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  camp       Camp             @relation(fields: [campId], references: [id], onDelete: Cascade)
  animateur  Animateur?       @relation(fields: [animateurId], references: [id])
  groupes    ActiviteGroupe[]

  @@map("activites")
}

// ─────────────────────────────────────────
//  ACTIVITE_GROUPE — Jonction many-to-many
// ─────────────────────────────────────────

model ActiviteGroupe {
  activiteId String @map("activite_id")
  groupeId   String @map("groupe_id")

  activite Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  groupe   Groupe   @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@id([activiteId, groupeId])
  @@map("activite_groupes")
}

// ─────────────────────────────────────────
//  PAIEMENT — Suivi financier
// ─────────────────────────────────────────

model Paiement {
  id            String          @id @default(uuid())
  participantId String?         @map("participant_id")
  campId        String?         @map("camp_id")
  libelle       String?
  montant       Decimal         @db.Decimal(10, 2)
  montantTotal  Decimal?        @map("montant_total") @db.Decimal(10, 2)
  statut        StatutPaiement  @default(EN_ATTENTE)
  methode       MethodePaiement @default(ESPECES)
  reference     String?
  datePaiement  DateTime?       @map("date_paiement")
  notes         String?
  recu          Boolean         @default(false)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // Relations
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("paiements")
}

// ─────────────────────────────────────────
//  DEPENSE — Sorties financières du camp
// ─────────────────────────────────────────

model Depense {
  id          String   @id @default(uuid())
  campId      String   @map("camp_id")
  libelle     String
  categorie   String
  montant     Decimal  @db.Decimal(10, 2)
  dateDepense DateTime @default(now()) @map("date_depense")
  reference   String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("depenses")
}

// ─────────────────────────────────────────
//  DOCUMENT — Pièces jointes
// ─────────────────────────────────────────

model Document {
  id            String         @id @default(uuid())
  participantId String         @map("participant_id")
  nom           String
  type          TypeDocument
  urlFichier    String         @map("url_fichier")
  statut        StatutDocument @default(EN_ATTENTE)
  tailleFichier Int?           @map("taille_fichier")
  mimeType      String?        @map("mime_type")
  notes         String?
  uploadedAt    DateTime       @default(now()) @map("uploaded_at")
  valideAt      DateTime?      @map("valide_at")

  // Relations
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ─────────────────────────────────────────
//  MESSAGE — Communication admin ↔ parents
// ─────────────────────────────────────────

model Message {
  id           String   @id @default(uuid())
  campId       String   @map("camp_id")
  expediteurId String   @map("expediteur_id")
  parentId     String?  @map("parent_id")
  sujet        String
  contenu      String
  lu           Boolean  @default(false)
  envoye       Boolean  @default(true)
  envoyeAt     DateTime @default(now()) @map("envoye_at")
  luAt         DateTime? @map("lu_at")

  // Relations
  camp       Camp      @relation(fields: [campId], references: [id], onDelete: Cascade)
  expediteur User      @relation("expediteur", fields: [expediteurId], references: [id])
  parent     Parent?   @relation(fields: [parentId], references: [id])

  @@map("messages")
}

// ─────────────────────────────────────────
//  NOTIFICATION — Alertes système
// ─────────────────────────────────────────

model Notification {
  id             String           @id @default(uuid())
  destinataireId String           @map("destinataire_id")
  campId         String?          @map("camp_id")
  titre          String
  message        String
  type           TypeNotification
  lue            Boolean          @default(false)
  lienAction     String?          @map("lien_action")
  createdAt      DateTime         @default(now()) @map("created_at")
  luAt           DateTime?        @map("lu_at")

  // Relations
  destinataire User  @relation(fields: [destinataireId], references: [id], onDelete: Cascade)
  camp         Camp? @relation(fields: [campId], references: [id])

  @@map("notifications")
}

// ─────────────────────────────────────────
//  STATISTIQUE_SNAP — Snapshots pour dashboard
// ─────────────────────────────────────────

model StatistiqueSnap {
  id                 String   @id @default(uuid())
  campId             String   @map("camp_id")
  dateSnap           DateTime @map("date_snap")
  totalParticipants  Int      @map("total_participants")
  totalConfirmes     Int      @map("total_confirmes")
  totalPaye          Int      @map("total_paye")
  revenusTotal       Decimal  @map("revenus_total") @db.Decimal(10, 2)
  revenusCibles      Decimal  @map("revenus_cibles") @db.Decimal(10, 2)
  activitesCount     Int      @map("activites_count")
  documentsValides   Int      @map("documents_valides")
  documentsPending   Int      @map("documents_pending")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("statistique_snaps")
}

// ─────────────────────────────────────────
//  FICHE_PRESENCE — Sorties/retours encadrants & enfants
// ─────────────────────────────────────────

model FichePresence {
  id           String       @id @default(uuid())
  campId       String       @map("camp_id")
  type         TypePresence @default(ANIMATEUR)
  nom          String
  prenom       String
  heureSortie  DateTime     @map("heure_sortie")
  motif        String
  heureRetour  DateTime?    @map("heure_retour")
  signature    String?
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("fiches_presence")
}

// ─────────────────────────────────────────
//  VISITEUR — Registre des visiteurs
// ─────────────────────────────────────────

model Visiteur {
  id           String   @id @default(uuid())
  campId       String   @map("camp_id")
  nom          String
  prenom       String
  telephone    String
  qualite      String
  notes        String?
  heureArrivee String?  @map("heure_arrivee")
  heureDepart  String?  @map("heure_depart")
  createdAt    DateTime @default(now()) @map("created_at")

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("visiteurs")
}

// ─────────────────────────────────────────
//  DON — Registre des dons reçus
// ─────────────────────────────────────────

// ─────────────────────────────────────────
//  ARTICLE SAC — Fouille des bagages
// ─────────────────────────────────────────

model ArticleSac {
  id            String   @id @default(uuid())
  participantId String   @map("participant_id")
  article       String
  quantite      Int      @default(1)
  categorie     String?
  confisque     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("articles_sac")
}

// ─────────────────────────────────────────
//  CAUSERIE_GROUPE — Causeries quotidiennes par groupe
// ─────────────────────────────────────────

model CauserieGroupe {
  id        String   @id @default(uuid())
  groupeId  String   @map("groupe_id")
  campId    String   @map("camp_id")
  date      DateTime @db.Date
  theme     String
  resume    String?  @db.Text
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groupe Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@unique([groupeId, date])
  @@map("causerie_groupes")
}

// ─────────────────────────────────────────
//  ENSEIGNEMENT — Journal des enseignements
// ─────────────────────────────────────────

model Enseignement {
  id        String   @id @default(uuid())
  campId    String   @map("camp_id")
  date      DateTime
  orateur   String
  theme     String
  contenu   String   @db.Text
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("enseignements")
}

model Don {
  id          String   @id @default(uuid())
  campId      String   @map("camp_id")
  nom         String
  prenom      String
  telephone   String
  description String
  montant     Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("dons")
}


// ─────────────────────────────────────────
//  ÉCOLE MATERNELLE
// ─────────────────────────────────────────

model Eleve {
  id              String    @id @default(uuid())
  campId          String    @map("camp_id")
  classeId        String?   @map("classe_id")
  nom             String
  prenom          String
  sexe            String?
  dateNaissance   DateTime? @map("date_naissance")
  lieuNaissance   String?   @map("lieu_naissance")
  parentNom       String?   @map("parent_nom")
  parentPrenom    String?   @map("parent_prenom")
  parentTelephone String?   @map("parent_telephone")
  adresse         String?
  infosMedicales  String?   @map("infos_medicales")
  groupeSanguin   String?   @map("groupe_sanguin")
  allergies       String?
  medicaments     String?
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  camp        Camp              @relation(fields: [campId], references: [id], onDelete: Cascade)
  paiements   PaiementEleve[]
  documents   DocumentEleve[]
  sorties     SortieEleve[]
  messages    MessageEcole[]
  classe      Classe?           @relation(fields: [classeId], references: [id], onDelete: SetNull)
  groupes     EleveGroupe[]
  evaluations EvaluationEleve[]
  presences   PresenceEleve[]

  @@index([campId])
  @@map("eleves")
}

model Classe {
  id     String @id @default(uuid())
  campId String @map("camp_id")
  nom    String
  niveau String?

  camp        Camp            @relation(fields: [campId], references: [id], onDelete: Cascade)
  eleves      Eleve[]
  enseignants Enseignant[]
  activites   ActiviteEcole[]
  lecons      LeconEcole[]

  @@index([campId])
  @@map("classes")
}

model GroupeEcole {
  id          String  @id @default(uuid())
  campId      String  @map("camp_id")
  nom         String
  couleur     String  @default("#6366f1")
  description String?

  camp      Camp             @relation(fields: [campId], references: [id], onDelete: Cascade)
  eleves    EleveGroupe[]
  causeries CauserieEcole[]

  @@index([campId])
  @@map("groupes_ecole")
}

model EleveGroupe {
  eleveId  String @map("eleve_id")
  groupeId String @map("groupe_id")

  eleve  Eleve       @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  groupe GroupeEcole @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@id([eleveId, groupeId])
  @@map("eleve_groupes")
}

model Competence {
  id     String @id @default(uuid())
  campId String @map("camp_id")
  nom    String
  ordre  Int    @default(0)

  camp        Camp              @relation(fields: [campId], references: [id], onDelete: Cascade)
  evaluations EvaluationEleve[]

  @@index([campId])
  @@map("competences")
}

model EvaluationEleve {
  id           String      @id @default(uuid())
  eleveId      String      @map("eleve_id")
  competenceId String      @map("competence_id")
  periode      String
  couleur      CouleurEval
  commentaire  String?
  updatedAt    DateTime    @updatedAt @map("updated_at")

  eleve      Eleve      @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  competence Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  @@unique([eleveId, competenceId, periode])
  @@map("evaluations_eleves")
}

model ProgrammeEcole {
  id        String        @id @default(uuid())
  campId    String        @map("camp_id")
  type      TypeProgramme
  titre     String
  contenu   String        @db.Text
  date      DateTime      @db.Date
  createdAt DateTime      @default(now()) @map("created_at")

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@index([campId])
  @@map("programmes_ecole")
}

model PresenceEleve {
  id      String   @id @default(uuid())
  eleveId String   @map("eleve_id")
  date    DateTime @db.Date
  present Boolean  @default(true)

  eleve Eleve @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@unique([eleveId, date])
  @@map("presences_eleves")
}


// ─────────────────────────────────────────
//  ÉCOLE — modules propres (personnel, finances, registres…)
// ─────────────────────────────────────────

model Enseignant {
  id          String    @id @default(uuid())
  campId      String    @map("camp_id")
  classeId    String?   @map("classe_id")
  nom         String
  prenom      String
  telephone   String?
  email       String?
  specialite  String?
  statut      String    @default("ACTIF")
  dateArrivee DateTime? @map("date_arrivee")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  camp      Camp            @relation(fields: [campId], references: [id], onDelete: Cascade)
  classe    Classe?         @relation(fields: [classeId], references: [id], onDelete: SetNull)
  activites ActiviteEcole[]
  lecons    LeconEcole[]

  @@index([campId])
  @@map("enseignants")
}

model ActiviteEcole {
  id           String   @id @default(uuid())
  campId       String   @map("camp_id")
